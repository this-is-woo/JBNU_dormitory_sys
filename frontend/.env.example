# 이 파일을 .env.local 로 복사해서 값을 채우세요. (Vercel 에서는 Project → Settings → Environment Variables)

# 백엔드(FastAPI, Render) 주소 — 끝에 / 를 붙이지 않습니다.
VITE_API_BASE_URL=http://localhost:8000

# Supabase (선택) — Supabase Dashboard → Project Settings → API Keys
# 비워 두면 생활관 목록은 내장된 기본 데이터로 표시됩니다.
# publishable 키(sb_publishable_...) 또는 legacy anon 키를 넣습니다. secret/service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# (선택) 구글 로그인 버튼 — Google Cloud → Google 인증 플랫폼 → 클라이언트 의 클라이언트 ID (...apps.googleusercontent.com)
# 넣으면 구글 로그인 창에 Supabase 주소 대신 이 사이트 주소가 표시됩니다.
VITE_GOOGLE_CLIENT_ID=

# (선택) 채팅 푸시 알림 — `npx web-push generate-vapid-keys` 로 만든 키 중 Public Key 만 넣습니다.
# Private Key 는 여기에도, 저장소에도 넣지 말고 Supabase Edge Function 비밀 값(VAPID_PRIVATE_KEY)에만 넣으세요.
# 비워 두면 알림 기능이 보이지 않습니다. (설정 순서: README 의 "⑤ 채팅 푸시 알림")
VITE_VAPID_PUBLIC_KEY=
