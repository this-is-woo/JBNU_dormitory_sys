# 이 파일을 .env.local 로 복사해서 값을 채우세요. (Vercel 에서는 Project → Settings → Environment Variables)

# 백엔드(FastAPI, Render) 주소 — 끝에 / 를 붙이지 않습니다.
VITE_API_BASE_URL=http://localhost:8000

# Supabase (선택) — Supabase Dashboard → Project Settings → API Keys
# 비워 두면 생활관 목록은 내장된 기본 데이터로 표시됩니다.
# publishable 키(sb_publishable_...) 또는 legacy anon 키를 넣습니다. secret/service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
