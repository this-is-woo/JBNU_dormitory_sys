# 이 파일을 .env 로 복사해서 값을 채우세요. (Render 에서는 Dashboard → Environment)

# 프론트엔드 주소(쉼표 구분). Vercel 배포 주소를 꼭 추가하세요. 예) https://jbnu-dorm.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# (선택) Vercel 프리뷰 배포 주소 패턴. 예) https://jbnu-dorm-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# (선택) Supabase — Project Settings → API Keys 의 secret 키(sb_secret_...) 또는 legacy service_role 키
# 서버 전용 키입니다. 프론트엔드/깃허브에 절대 올리지 마세요.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supabase 가 설정돼 있을 때 예측 요청을 prediction_logs 테이블에 기록할지
LOG_PREDICTIONS=true

# (선택) 모델 파일 경로. 기본값은 backend/models/model.onnx, backend/models/model_meta.json
# MODEL_PATH=models/model.onnx
# MODEL_META_PATH=models/model_meta.json
